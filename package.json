{
  "name": "storybook-addon-mock-date",
  "version": "3.2.1",
  "description": "Storybook addon that mocks the JavaScript Date — and opt-in Temporal and Intl.DateTimeFormat — for individual stories.",
  "keywords": [
    "storybook-addon",
    "data-state",
    "mock-date",
    "mocking",
    "date",
    "time",
    "temporal",
    "fake-timers"
  ],
  "license": "MIT",
  "author": "k35o <kosakanoki@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/k35o/storybook-addon-mock-date.git"
  },
  "files": [
    "dist/**/*",
    "manager.js",
    "preview.js",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./manager": "./dist/manager.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "build:watch": "vp pack --watch",
    "typecheck": "tsc --noEmit",
    "check": "vp check",
    "check:write": "vp check --fix",
    "test": "vitest run",
    "start": "run-p build:watch 'storybook --quiet'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@sinonjs/fake-timers": "15.4.0"
  },
  "devDependencies": {
    "@k8o/oxc-config": "0.2.1",
    "@storybook/addon-docs": "next",
    "@storybook/addon-vitest": "next",
    "@storybook/icons": "2.1.0",
    "@storybook/react-vite": "next",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser-playwright": "4.1.10",
    "npm-run-all2": "9.0.3",
    "playwright": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "next",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plus": "0.2.9",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "storybook": "^10.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "storybook": {
    "displayName": "Mocking Date",
    "icon": "https://raw.githubusercontent.com/k35o/storybook-addon-mock-date/main/.github/icon.png"
  }
}
